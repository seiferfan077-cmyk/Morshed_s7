{
  "expo": {
    "name": "مُرشد - S7",
    "slug": "murshid-s7",
    "version": "0.1.1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.murshid.s7"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-media-library",
        {
          "photosPermission": "اسمح لمُرشد بعرض الصور والفيديوهات الموجودة على جهازك.",
          "savePhotosPermission": "اسمح لمُرشد بحفظ الوسائط على جهازك عند طلبك ذلك.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-secure-store",
      "expo-video",
      "./plugins/withMurshidDialer",
      "expo-image"
    ],
    "extra": {
      "eas": {
        "projectId": "c4512276-2c5f-4cd5-8c32-ef4550c79cf4"
      }
    },
    "owner": "seif07",
    "updates": {
      "url": "https://u.expo.dev/c4512276-2c5f-4cd5-8c32-ef4550c79cf4"
    }
  }
}
