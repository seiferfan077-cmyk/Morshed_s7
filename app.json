{
  "expo": {
    "name": "مُرشد - S7",
    "slug": "murshid-s7",
    "version": "0.4.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "يستخدم مُرشد موقعك أثناء استخدام التطبيق لعرض مواقيت الصلاة واتجاه القبلة بدقة."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.murshid.s7",
      "versionCode": 8,
      "permissions": [
        "com.android.launcher.permission.INSTALL_SHORTCUT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-media-library",
        {
          "photosPermission": "اسمح لمُرشد بعرض الصور والفيديوهات الموجودة على جهازك.",
          "savePhotosPermission": "اسمح لمُرشد بحفظ الوسائط على جهازك عند طلبك ذلك.",
          "granularPermissions": ["photo", "video"],
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-secure-store",
      "expo-location",
      "expo-video",
      [
        "expo-notifications",
        {
          "color": "#E53935",
          "defaultChannel": "murshid-daily-updates"
        }
      ],
      "./plugins/withMurshidDialer",
      "./plugins/withMurshidLargeHeap",
      "expo-image",
      "expo-audio",
      "expo-asset",
      "expo-sqlite",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "c4512276-2c5f-4cd5-8c32-ef4550c79cf4"
      }
    },
    "owner": "seif07",
    "updates": {
      "url": "https://u.expo.dev/c4512276-2c5f-4cd5-8c32-ef4550c79cf4",
      "checkAutomatically": "NEVER"
    },
    "scheme": "murshid"
  }
}
