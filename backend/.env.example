# Backend-only settings. Store real values in Vercel Environment Variables, never in Git or Expo EXPO_PUBLIC_* settings.
AI_PROVIDER=groq
MURSHID_API_TOKEN=

# Groq (recommended free pilot option)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Optional Gemini alternative. Set AI_PROVIDER=gemini to use it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
