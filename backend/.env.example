# Backend-only settings. Store these in Cloudflare Worker secrets/vars or Vercel Environment Variables.
# Never commit real values or place server secrets in EXPO_PUBLIC_* variables.
AI_PROVIDER=gemini
FIREBASE_PROJECT_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional Groq fallback (if AI_PROVIDER=groq).
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# One-time bootstrap secrets. After first setup, each admin chooses a permanent password in the app.
CHANNEL_OWNER_TEMP_PASSWORD=
CHANNEL_ADMIN_TEMP_PASSWORD=
# Optional hardening: comma-separated Firebase UIDs allowed to perform first-time bootstrap.
CHANNEL_OWNER_BOOTSTRAP_UIDS=
CHANNEL_ADMIN_BOOTSTRAP_UIDS=

# Optional Expo Push service access token; kept on the Worker, never in the mobile app.
EXPO_ACCESS_TOKEN=
# CHANNEL_DB is configured as a D1 binding in wrangler.toml.
