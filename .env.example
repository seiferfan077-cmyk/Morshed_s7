# Local Expo client settings. EXPO_PUBLIC_* values are included in the mobile app bundle.
# Keep this to public configuration only; never put provider API keys here.
EXPO_PUBLIC_API_BASE_URL=https://api.example.com
# Personal-build access token for the Murshid Backend. Store the real value only in local/EAS env, never commit it.
EXPO_PUBLIC_MURSHID_API_TOKEN=

# Firebase public project identifiers (not Admin SDK credentials).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Provider API keys belong in the backend host's secret environment, never in this file.

# EAS Update channels are configured in EAS, not with client-side secrets:
# development / preview / production
