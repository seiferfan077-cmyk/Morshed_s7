# إعدادات عامة للتطبيق. قيم EXPO_PUBLIC_* تُضمّن في حزمة التطبيق ولا تضع فيها أسرار مزود الذكاء الاصطناعي.
# هذا هو Backend مرشد المركزي المنشور؛ يمكن استبداله بعنوان خدمة أخرى عند الحاجة.
EXPO_PUBLIC_API_BASE_URL=https://murshid-ai-backend.murshid-s7.workers.dev

# إعدادات Firebase Web العامة، وليست بيانات Admin SDK.
# يلزم ضبطها في بيئة البناء كي يحصل التطبيق على Firebase ID token للمحادثة الآمنة.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# لا تضع GEMINI_API_KEY أو أي مفتاح مزود في التطبيق أو ملفات EXPO_PUBLIC_*.
# تُحفظ مفاتيح المزود على Backend فقط.
