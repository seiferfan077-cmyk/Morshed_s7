# Never commit real values. The mobile client should only receive public configuration.
EXPO_PUBLIC_API_BASE_URL=https://api.example.com

# Firebase Web config: public identifiers only; never put Admin SDK credentials here.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Backend-only secrets belong in the backend deployment, never in Expo.
AI_PROVIDER_API_KEY=server-side-only

# EAS Update channels are configured outside the mobile bundle:
# development / preview / production
