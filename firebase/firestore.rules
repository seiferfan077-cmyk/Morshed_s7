rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    // Read access is limited to admins until a public-content model is explicitly approved.
    match /hubProposals/{proposalId} {
      allow read, write: if isAdmin();
    }

    match /hubReleases/{releaseId} {
      allow read, write: if isAdmin();
    }

    match /hubAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /hubSettings/{key} {
      allow read, write: if isAdmin();
    }

    // Deny all unspecified collections by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
